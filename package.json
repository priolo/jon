{
  "name": "@priolo/jon",
  "version": "1.1.1",
  "private": false,
  "description": "React manager state with reducers hooks",
  "author": "Iorio Ivano <iorioivano@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/priolo/jon",
  "repository": {
    "type": "git",
    "url": "https://github.com/priolo/jon.git"
  },
  "keywords": [
    "react",
    "store",
    "hooks",
    "reducer"
  ],
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --mode production --sourcemap --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "pub": "npm publish --access public"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "latest",
    "typescript": "^5.4.5",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "browserslist": "defaults and supports es6-module,maintained node versions"
}